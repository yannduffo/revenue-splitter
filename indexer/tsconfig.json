{
    "compilerOptions": {
      "strict": true,
      "noUncheckedIndexedAccess": true,

      "target": "ES2023",
      "lib": ["ES2023"],
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "types": ["node"],

      // Node runs the .ts directly, tsc only type-checks
      "noEmit": true,
      "allowImportingTsExtensions": true,
      "verbatimModuleSyntax": true,
      "erasableSyntaxOnly": true,

      "skipLibCheck": true
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules"]
  }
