# --- web (build args: inlined by next build)
NEXT_PUBLIC_CHAIN=sepolia
NEXT_PUBLIC_SITE_URL=https://xxxx.xyz
NEXT_PUBLIC_SEPOLIA_FACTORY=0x...
NEXT_PUBLIC_SEPOLIA_IMPLEMENTATION=0x...
NEXT_PUBLIC_SEPOLIA_DEMO_SPLITTER_A=0x...
NEXT_PUBLIC_SEPOLIA_DEMO_SPLITTER_B=0x...
NEXT_PUBLIC_SEPOLIA_DEMO_TOKENS=0x...,0x...

# --- web (runtime)
INFURA_API_KEY=xxxxx

# --- indexer + database
POSTGRES_PASSWORD=xxxxx          # openssl rand -hex 24
INDEXER_RPC_URL=https://sepolia.infura.io/v3/xxxxx
SEPOLIA_FACTORY_BLOCK=xxxxx
